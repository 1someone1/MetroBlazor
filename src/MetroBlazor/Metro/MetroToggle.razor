@namespace MetroBlazor

<button type="button"
        class="metro-toggle @(Checked ? "checked" : null)"
        role="switch"
        aria-checked="@(Checked ? "true" : "false")"
        aria-label="@Label"
        disabled="@Disabled"
        @onclick="Toggle">
    <span class="metro-toggle-track" aria-hidden="true">
        <span class="metro-toggle-thumb"></span>
    </span>
    <span class="metro-toggle-label">@Label</span>
</button>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private async Task Toggle()
    {
        if (!Disabled && CheckedChanged.HasDelegate)
        {
            await CheckedChanged.InvokeAsync(!Checked);
        }
    }
}
