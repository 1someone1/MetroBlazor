@namespace MetroBlazor

@if (Open)
{
    <div class="metro-flyout-layer" @onclick="CloseFromScrim">
        <section class="metro-flyout metro-flyout-@Placement" role="dialog" aria-label="@Title" @onclick:stopPropagation="true">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <header class="metro-flyout-header"><h2>@Title</h2><button type="button" aria-label="Close" @onclick="Close">×</button></header>
            }
            <div class="metro-flyout-content">@ChildContent</div>
        </section>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Placement { get; set; } = "bottom";
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private Task Close() => OnClose.InvokeAsync();
    private Task CloseFromScrim() => Close();
}
