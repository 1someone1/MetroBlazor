@namespace MetroBlazor
@implements IDisposable

<section class="metro-tile-group @Class" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <header class="metro-tile-group-header"><MetroText TextStyle="MetroTextStyle.Subheader">@Title</MetroText></header>
    }
    @if (Items is not null)
    {
        <div class="metro-tile-group-grid metro-tile-group-sortable">
            @for (var index = 0; index < orderedItems.Count; index++)
            {
                var item = orderedItems[index];
                <div class="metro-tile-group-item @(editMode ? "editing" : null) @(draggingIndex == index ? "dragging" : null)"
                     draggable="false"
                     @onpointerdown="@((PointerEventArgs _) => BeginLongPress(index))"
                     @onpointerup="CancelLongPress"
                     @onpointerleave="CancelLongPress"
                     @oncontextmenu="@((MouseEventArgs _) => EnterEditMode())"
                     @oncontextmenu:preventDefault="true"
                     tabindex="-1"
                     @ondragstart="@((DragEventArgs _) => BeginDrag(index))"
                     @ondragend="EndDrag"
                     @ondragover:preventDefault="true"
                     @ondragenter:preventDefault="true"
                     @ondrop="@((DragEventArgs _) => Drop(index))">
                    <MetroTile Label="@item.Label"
                               SubLabel="@item.SubLabel"
                               Icon="@item.Icon"
                               AccentColor="@item.AccentColor"
                               Size="@item.Size"
                               Draggable="@editMode"
                               OnDragStart="@((DragEventArgs _) => BeginDrag(index))"
                               OnDragEnd="EndDrag" />
                    @if (editMode)
                    {
                        <button type="button" class="metro-tile-edit-control metro-tile-close" title="Remove tile" aria-label="Remove @item.Label tile" @onclick="@((MouseEventArgs _) => RemoveItem(item))" @onfocusout="OnControlFocusOut" @onclick:stopPropagation="true">×</button>
                        <button type="button" class="metro-tile-edit-control metro-tile-size-button" title="Change tile size" aria-label="Change @item.Label tile size" @onclick="@((MouseEventArgs _) => CycleSize(item))" @onfocusout="OnControlFocusOut" @onclick:stopPropagation="true">↗</button>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="metro-tile-group-grid">@ChildContent</div>
    }
</section>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public IList<MetroAppItem>? Items { get; set; }
    [Parameter] public EventCallback<MetroAppItem> ItemMoved { get; set; }
    [Parameter] public EventCallback<MetroAppItem> ItemSizeChanged { get; set; }
    [Parameter] public EventCallback<MetroAppItem> ItemRemoved { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private IList<MetroAppItem>? sourceItems;
    private List<MetroAppItem> orderedItems = new();
    private int draggingIndex = -1;
    private int longPressIndex = -1;
    private bool editMode;
    private CancellationTokenSource? longPressCancellation;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(sourceItems, Items))
        {
            sourceItems = Items;
            orderedItems = Items is null ? new List<MetroAppItem>() : Items.ToList();
        }
    }

    private void BeginLongPress(int index)
    {
        CancelLongPress();
        longPressIndex = index;
        longPressCancellation = new CancellationTokenSource();
        var token = longPressCancellation.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(450, token);
                await InvokeAsync(() =>
                {
                    editMode = true;
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException)
            {
            }
        }, token);
    }

    private void CancelLongPress()
    {
        longPressCancellation?.Cancel();
        longPressCancellation?.Dispose();
        longPressCancellation = null;
        longPressIndex = -1;
    }

    private void EnterEditMode()
    {
        CancelLongPress();
        editMode = !editMode;
        draggingIndex = -1;
    }

    private void OnControlFocusOut(FocusEventArgs _) => HideEditMode();
    private void HideEditMode()
    {
        editMode = false;
        draggingIndex = -1;
    }

    private void BeginDrag(int index)
    {
        if (editMode)
        {
            draggingIndex = index;
        }
    }

    private Task EndDrag(DragEventArgs _) { draggingIndex = -1; return Task.CompletedTask; }

    private async Task Drop(int targetIndex)
    {
        if (!editMode || draggingIndex < 0 || draggingIndex >= orderedItems.Count || draggingIndex == targetIndex)
        {
            draggingIndex = -1;
            return;
        }

        var item = orderedItems[draggingIndex];
        orderedItems.RemoveAt(draggingIndex);
        orderedItems.Insert(Math.Min(targetIndex, orderedItems.Count), item);
        draggingIndex = -1;
        await ItemMoved.InvokeAsync(item);
    }

    private async Task CycleSize(MetroAppItem item)
    {
        item.Size = item.Size switch
        {
            MetroTileSize.Small => MetroTileSize.Medium,
            MetroTileSize.Medium => MetroTileSize.Wide,
            MetroTileSize.Wide => MetroTileSize.Large,
            _ => MetroTileSize.Small
        };
        await ItemSizeChanged.InvokeAsync(item);
    }

    private async Task RemoveItem(MetroAppItem item)
    {
        orderedItems.Remove(item);
        await ItemRemoved.InvokeAsync(item);
    }

    public void Dispose()
    {
        longPressCancellation?.Cancel();
        longPressCancellation?.Dispose();
    }
}
