@namespace MetroBlazor

<section class="metro-hub @Class" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <header class="metro-hub-header">
            <p class="metro-hub-eyebrow">@Eyebrow</p>
            <h2>@Title</h2>
        </header>
    }
    <div class="metro-hub-content">@ChildContent</div>
</section>

@code {
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
