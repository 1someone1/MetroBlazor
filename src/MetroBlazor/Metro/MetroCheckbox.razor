@namespace MetroBlazor

<label class="metro-checkbox @(Disabled ? "disabled" : null)">
    <input type="checkbox"
           checked="@Checked"
           disabled="@Disabled"
           @onchange="OnChanged" />
    <span class="metro-checkbox-box" aria-hidden="true"></span>
    <span class="metro-checkbox-label">@Label</span>
</label>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private async Task OnChanged(ChangeEventArgs args)
    {
        if (!Disabled && CheckedChanged.HasDelegate)
        {
            await CheckedChanged.InvokeAsync(args.Value is bool value && value);
        }
    }
}
