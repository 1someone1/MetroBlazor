@namespace MetroBlazor

<button type="@Type"
         class="@CssClass"
         aria-label="@(IconOnly ? AriaLabel : null)"
         disabled="@Disabled"
        @onclick="OnButtonClick"
        @attributes="AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <MetroIcon Name="@Icon" Size="MetroIconSize.Medium" />
    }
    @if (!IconOnly)
    {
        @ChildContent
    }
</button>

@code {
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Quiet { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public bool IconOnly { get; set; }
    [Parameter] public bool Bordered { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => string.Join(' ', new[]
    {
        "metro-button",
        Quiet ? "metro-button-quiet" : null,
        IconOnly ? "metro-button-icon-only" : null,
        Bordered ? "metro-button-bordered" : null,
        Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private async Task OnButtonClick(MouseEventArgs e)
    {
        if (!Disabled && OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(e);
        }
    }
}
