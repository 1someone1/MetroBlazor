@namespace MetroBlazor
@implements IDisposable

<button type="button"
        class="@CssClass"
        style="@Style"
        disabled="@Disabled"
        aria-pressed="@(Selected ? "true" : "false")"
        aria-label="@Label"
        draggable="@(Draggable ? "true" : "false")"
        @onclick="OnTileClick"
        @ondragstart="HandleDragStart"
        @ondragend="HandleDragEnd"
        @attributes="AdditionalAttributes">
    @if (showingPage >= 0 && livePages.Count > 0)
    {
        @* @key forces a fresh element per page so the entrance animation replays on every flip. *@
        <span class="metro-tile-live-content" @key="showingPage">@livePages[showingPage]</span>
    }
    else if (Live && livePages.Count > 0)
    {
        <span class="metro-tile-front-content" @key="FrontPageKey">
            @FrontContent
        </span>
    }
    else
    {
        @FrontContent
    }
</button>

@code {
    private const int FrontPageKey = -1;

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? SubLabel { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? AccentColor { get; set; }
    [Parameter] public MetroTileSize Size { get; set; } = MetroTileSize.Medium;
    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Draggable { get; set; }
    [Parameter] public EventCallback<DragEventArgs> OnDragStart { get; set; }
    [Parameter] public EventCallback<DragEventArgs> OnDragEnd { get; set; }
    [Parameter] public bool Live { get; set; }
    [Parameter] public int LiveInterval { get; set; } = 4000;
    [Parameter] public RenderFragment? LiveContent { get; set; }
    [Parameter] public string? LiveText { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => string.Join(' ', new[]
    {
        "metro-tile",
        $"metro-tile-{Size.ToString().ToLowerInvariant()}",
        Selected ? "selected" : null,
        Disabled ? "disabled" : null,
        Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));

    private string? Style => string.IsNullOrWhiteSpace(AccentColor)
        ? null
        : $"--metro-tile-accent: {AccentColor};";

    private Timer? liveTimer;
    private int showingPage = FrontPageKey;
    private IReadOnlyList<RenderFragment> livePages = [];

    // The default tile face, factored out so live tiles can wrap it in an
    // animated container without duplicating the markup.
    private RenderFragment FrontContent => @<text>
        @if (!string.IsNullOrEmpty(Icon))
        {
            @if (MetroIconCatalog.ResolvePath(Icon) is not null)
            {
                <span class="metro-tile-icon" aria-hidden="true"><MetroIcon Name="@Icon" Size="MetroIconSize.Medium" /></span>
            }
            else
            {
                <span class="metro-tile-icon" aria-hidden="true">@Icon</span>
            }
        }
        <span class="metro-tile-label">@Label</span>
        @if (!string.IsNullOrEmpty(SubLabel))
        {
            <span class="metro-tile-sublabel">@SubLabel</span>
        }
        @if (ChildContent is not null)
        {
            @ChildContent
        }
    </text>;

    protected override void OnParametersSet()
    {
        livePages = BuildLivePages();
        if (showingPage >= livePages.Count)
        {
            showingPage = FrontPageKey;
        }

        if (Live && livePages.Count > 0 && liveTimer is null)
        {
            liveTimer = new Timer(_ => AdvanceLiveContent(), null, LiveInterval, LiveInterval);
        }
        else if ((!Live || livePages.Count == 0) && liveTimer is not null)
        {
            liveTimer.Dispose();
            liveTimer = null;
            showingPage = FrontPageKey;
        }
    }

    // LiveContent counts as the first page; LiveText is split into as many
    // pages as the tile size can hold. The cycle is front → page 1..n → front.
    private IReadOnlyList<RenderFragment> BuildLivePages()
    {
        var pages = new List<RenderFragment>();
        if (LiveContent is not null)
        {
            pages.Add(LiveContent);
        }
        if (!string.IsNullOrWhiteSpace(LiveText))
        {
            foreach (var chunk in SplitLiveText(LiveText, LivePageCapacity))
            {
                var text = chunk;
                pages.Add(builder => builder.AddContent(0, text));
            }
        }
        return pages;
    }

    // Approximate characters of 13px live text that fit one page at each size.
    private int LivePageCapacity => Size switch
    {
        MetroTileSize.Small => 40,
        MetroTileSize.Medium => 70,
        MetroTileSize.Wide => 160,
        MetroTileSize.Large => 320,
        _ => 70,
    };

    internal static IEnumerable<string> SplitLiveText(string text, int capacity)
    {
        var remaining = text.Trim();
        while (remaining.Length > capacity)
        {
            var breakAt = remaining[..capacity].LastIndexOf(' ');
            if (breakAt <= 0)
            {
                breakAt = capacity;
            }
            yield return remaining[..breakAt].Trim();
            remaining = remaining[breakAt..].TrimStart();
        }
        if (remaining.Length > 0)
        {
            yield return remaining;
        }
    }

    private void AdvanceLiveContent()
    {
        _ = InvokeAsync(() =>
        {
            showingPage = showingPage + 1 >= livePages.Count ? FrontPageKey : showingPage + 1;
            StateHasChanged();
        });
    }

    private async Task OnTileClick(MouseEventArgs e)
    {
        if (!Disabled && OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(e);
        }
    }

    private Task HandleDragStart(DragEventArgs args) => OnDragStart.InvokeAsync(args);
    private Task HandleDragEnd(DragEventArgs args) => OnDragEnd.InvokeAsync(args);

    public void Dispose() => liveTimer?.Dispose();
}
