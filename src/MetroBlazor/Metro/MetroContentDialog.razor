@namespace MetroBlazor

@if (Open)
{
    <div class="metro-dialog-layer">
        <div class="metro-dialog" role="dialog" aria-modal="true" aria-labelledby="@TitleId">
            <header class="metro-dialog-header"><h2 id="@TitleId">@Title</h2></header>
            <div class="metro-dialog-content">@ChildContent</div>
            <footer class="metro-dialog-actions">
                <MetroButton OnClick="Confirm">@ConfirmText</MetroButton>
                @if (!string.IsNullOrWhiteSpace(CancelText))
                {
                    <MetroButton Quiet OnClick="Cancel">@CancelText</MetroButton>
                }
            </footer>
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string ConfirmText { get; set; } = "OK";
    [Parameter] public string? CancelText { get; set; } = "Cancel";
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string TitleId { get; } = $"metro-dialog-{Guid.NewGuid():N}";
    private Task Confirm(MouseEventArgs _) => OnConfirm.InvokeAsync();
    private Task Cancel(MouseEventArgs _) => OnCancel.InvokeAsync();
}
