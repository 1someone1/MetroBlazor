@namespace MetroBlazor

<div class="metro-app-grid @Class" style="--metro-app-grid-columns: @Columns;" @attributes="AdditionalAttributes">
    @if (Items is not null)
    {
        @foreach (var item in Items)
        {
            <MetroTile Label="@item.Label"
                       SubLabel="@item.SubLabel"
                       Icon="@item.Icon"
                       AccentColor="@item.AccentColor"
                       Size="@item.Size"
                       OnClick="@((MouseEventArgs _) => SelectItem(item))" />
        }
    }
    @ChildContent
</div>

@code {
    [Parameter] public IEnumerable<MetroAppItem>? Items { get; set; }
    [Parameter] public EventCallback<MetroAppItem> ItemClick { get; set; }
    [Parameter] public int Columns { get; set; } = 4;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private async Task SelectItem(MetroAppItem item)
    {
        if (ItemClick.HasDelegate)
        {
            await ItemClick.InvokeAsync(item);
        }
    }
}
