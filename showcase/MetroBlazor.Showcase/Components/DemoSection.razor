@namespace MetroBlazor.Showcase.Components

<section class="showcase-section" aria-labelledby="@HeadingId">
    <div class="showcase-section-heading">
        <MetroText TextStyle="MetroTextStyle.Header" id="@HeadingId">@Title</MetroText>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <MetroText TextStyle="MetroTextStyle.Body">@Description</MetroText>
        }
    </div>
    @ChildContent
    @if (!string.IsNullOrWhiteSpace(Code))
    {
        <details class="showcase-code">
            <summary>View code</summary>
            <pre><code>@Code</code></pre>
        </details>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Code { get; set; }
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }

    private string HeadingId { get; } = $"demo-section-{Guid.NewGuid():N}";
}
