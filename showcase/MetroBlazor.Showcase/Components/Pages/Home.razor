    private string CurrentTitle => navigationItems.FirstOrDefault(item => item.Key == selectedControl)?.Label ?? "Overview";

    private IReadOnlyList<MetroBreadcrumbItem> HeaderBreadcrumb
    {
        get
        {
            var current = navigationItems.FirstOrDefault(item => item.Key == selectedControl);
            return
            [
                new() { Key = "components", Label = "Components" },
                new() { Key = "group", Label = current?.Group ?? "Getting started" },
                new() { Key = selectedControl, Label = CurrentTitle }
            ];
        }
    }

    private Task HeaderBreadcrumbClicked(MetroBreadcrumbItem item)
        => SelectControl(item.Key is "components" or "group" ? "overview" : item.Key);
    private string CurrentDescription => selectedControl switch
    {
        "tile" => "Metro tiles are square, colorful, and sized for touch.",
        "progress" => "Progress uses segmented blocks and explicit motion states.",
        "blade" => "Blades reveal context without leaving the current surface.",
        _ => "A MetroBlazor component reference surface."
    };

    private Task SelectControl(string key)
    {
        selectedControl = key;
        bladeOpen = false;
        appBarOpen = false;
        return Task.CompletedTask;
    }

    private Task SetDarkTheme(MouseEventArgs _) => SetTheme(MetroThemeVariant.Dark);
    private Task SetLightTheme(MouseEventArgs _) => SetTheme(MetroThemeVariant.Light);
    private Task SetBlueTheme(MouseEventArgs _) => SetTheme(MetroThemeVariant.Blue);
    private Task SetPurpleTheme(MouseEventArgs _) => SetTheme(MetroThemeVariant.Purple);

    private Task SetTheme(MetroThemeVariant variant)
    {
        showcaseTheme = variant;
        if (ThemeState is not null)
        {
            ThemeState.Variant = variant;
        }
        return Task.CompletedTask;
    }

    private Task CloseBlade()
    {
        bladeOpen = false;
        return Task.CompletedTask;
    }

    private Task OpenBlade(MouseEventArgs _)
    {
        bladeOpen = true;
        return Task.CompletedTask;
    }

    private Task TileClicked(MouseEventArgs _)
    {
        tileStatus = "Tile activated. Try keyboard focus, Enter, Space, and touch input.";
        return Task.CompletedTask;
    }

    private Task AppClicked(MetroAppItem item)
    {
        appStatus = $"{item.Label} activated.";
        return Task.CompletedTask;
    }

    private Task OnNameChanged(string? value)
    {
        displayName = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task OnIconQueryChanged(string? value)
    {
        iconQuery = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private async Task Save(MouseEventArgs _)
    {
        saving = true;
        saveStatus = "Saving...";
        await Task.Delay(350);
        saving = false;
        saveStatus = $"Saved at {DateTime.Now:HH:mm:ss}.";
    }

    private Task IncreaseProgress(MouseEventArgs _)
    {
        progressValue = Math.Min(progressValue + 10, 100);
        return Task.CompletedTask;
    }

    private Task DecreaseProgress(MouseEventArgs _)
    {
        progressValue = Math.Max(progressValue - 10, 0);
        return Task.CompletedTask;
    }

    private Task ChangeTransition(MouseEventArgs _)
    {
        transitionKey++;
        return Task.CompletedTask;
    }

    private Task BreadcrumbClicked(MetroBreadcrumbItem item)
    {
        currentBreadcrumb = item.Key;
        return Task.CompletedTask;
    }

    private Task TreeNodeClicked(MetroTreeNode node)
    {
        selectedTreeNode = node.Key;
        treeStatus = $"{node.Label} selected.";
        return Task.CompletedTask;
    }

    private Task GroupItemMoved(MetroAppItem item)
    {
        groupStatus = $"Moved {item.Label}.";
        return Task.CompletedTask;
    }

    private Task GroupItemSizeChanged(MetroAppItem item)
    {
        groupStatus = $"{item.Label} is now {item.Size}.";
        return Task.CompletedTask;
    }

    private Task SetRadio(string value) { radioValue = value; return Task.CompletedTask; }
    private Task ListClicked(string item) { listStatus = $"{item} selected."; return Task.CompletedTask; }
    private Task CommandClicked(MetroCommandItem command) { commandStatus = $"{command.Label} invoked."; return Task.CompletedTask; }
    private Task ToggleAppBar(MouseEventArgs _) { appBarOpen = !appBarOpen; return Task.CompletedTask; }
    private Task SetAppBar(bool value) { appBarOpen = value; return Task.CompletedTask; }
    private Task CloseAppBar(MouseEventArgs _) { appBarOpen = false; return Task.CompletedTask; }
    private Task OpenFlyout(MouseEventArgs _) { flyoutOpen = true; return Task.CompletedTask; }
    private Task CloseFlyout() { flyoutOpen = false; return Task.CompletedTask; }
    private Task OpenDialog(MouseEventArgs _) { dialogOpen = true; return Task.CompletedTask; }
    private Task CloseDialog() { dialogOpen = false; return Task.CompletedTask; }
    private Task RowClicked(DemoRow row) { rowStatus = $"{row.Name} selected."; return Task.CompletedTask; }

    private sealed record DemoRow(string Name, string Status, string Size);
    private sealed record IconRow(IReadOnlyList<string> Names);
}
