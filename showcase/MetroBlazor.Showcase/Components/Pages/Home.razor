@page "/"

<PageTitle>MetroBlazor — Windows 8.1 Metro UI for Blazor</PageTitle>

<MetroText TextStyle="MetroTextStyle.Body" Class="showcase-lede">
    MetroBlazor brings the flat, squared, touch-first look and feel of Windows 8.1 Metro to modern
    browsers. Every page of this documentation is built with the library itself — the sidebar,
    breadcrumb, tiles, and theme switcher above are all MetroBlazor components.
</MetroText>

@foreach (var group in DocsCatalog.ComponentGroups)
{
    <DemoSection Title="@group.Key">
        <div class="showcase-tile-row">
            @foreach (var (entry, index) in group.Select((item, i) => (item, i)))
            {
                <MetroTile Label="@entry.Title"
                           SubLabel="@entry.Description"
                           Icon="@entry.Icon"
                           AccentColor="@GroupAccent(entry.Group)"
                           Size="@TileSizeFor(entry)"
                           Live="true"
                           LiveInterval="@(4000 + index * 600)"
                           LiveText="@entry.Description"
                           OnClick="@(_ => Navigation.NavigateTo(entry.Route))" />
            }
        </div>
    </DemoSection>
}

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    // Short descriptions fit a square Medium tile; longer ones get a Wide tile.
    private static MetroTileSize TileSizeFor(DocsEntry entry) =>
        entry.Description.Length <= 55 ? MetroTileSize.Medium : MetroTileSize.Wide;

    private static string GroupAccent(string group) => group switch
    {
        "Foundation" => "#5C2D91",
        "Surface" => "#0078D7",
        "Forms" => "#008272",
        "Feedback" => "#CA5010",
        "Collections" => "#107C10",
        "Navigation" => "#C239B3",
        "Layout" => "#E81123",
        _ => "#0078D7",
    };
}
