@page "/components/select"

<PageTitle>Select — MetroBlazor</PageTitle>

<DemoSection Title="Options" Description="A native select with Metro underline treatment and accessible label association."
             Code="@BasicCode">
    <div class="showcase-control-card showcase-single-demo">
        <MetroSelect Label="Storage location" Options="selectOptions" @bind-Value="selectedOption" />
        <MetroText TextStyle="MetroTextStyle.Caption" class="showcase-status" aria-live="polite">Selected: @selectedOption</MetroText>
    </div>
</DemoSection>

<DemoSection Title="States" Description="Options can be disabled individually, and the whole control can be disabled."
             Code="@StatesCode">
    <div class="showcase-control-card showcase-single-demo">
        <MetroSelect Label="With a disabled option" Options="optionsWithDisabled" @bind-Value="limitedOption" />
        <MetroSelect Label="Disabled" Options="selectOptions" Value="local" Disabled="true" />
    </div>
</DemoSection>

<DemoSection Title="Parameters">
    <MetroDataGrid TItem="ParamRow" Items="parameters">
        <HeaderTemplate><th>Name</th><th>Type</th><th>Description</th></HeaderTemplate>
        <RowTemplate Context="p"><td><code>@p.Name</code></td><td>@p.Type</td><td>@p.Description</td></RowTemplate>
    </MetroDataGrid>
</DemoSection>

@code {
    private const string BasicCode = @"<MetroSelect Label=""Storage location"" Options=""selectOptions"" @bind-Value=""selectedOption"" />

@code {
    private readonly IReadOnlyList<MetroSelectOption> selectOptions =
    [
        new() { Value = ""local"", Label = ""Local storage"" },
        new() { Value = ""cloud"", Label = ""Cloud storage"" },
        new() { Value = ""usb"", Label = ""USB device"" }
    ];
}";

    private const string StatesCode = @"new MetroSelectOption { Value = ""network"", Label = ""Network drive"", Disabled = true }";

    private string selectedOption = "local";
    private string limitedOption = "local";

    private readonly IReadOnlyList<MetroSelectOption> selectOptions =
    [
        new() { Value = "local", Label = "Local storage" },
        new() { Value = "cloud", Label = "Cloud storage" },
        new() { Value = "usb", Label = "USB device" }
    ];

    private readonly IReadOnlyList<MetroSelectOption> optionsWithDisabled =
    [
        new() { Value = "local", Label = "Local storage" },
        new() { Value = "cloud", Label = "Cloud storage" },
        new() { Value = "network", Label = "Network drive", Disabled = true }
    ];

    private readonly IReadOnlyList<ParamRow> parameters =
    [
        new("Options", "IEnumerable<MetroSelectOption>", "Options to render. MetroSelectOption exposes Value, Label, and Disabled. (required)"),
        new("Value", "string?", "Value of the selected option. Combine with ValueChanged or @bind-Value."),
        new("ValueChanged", "EventCallback<string?>", "Invoked when the selection changes; supports @bind-Value."),
        new("Label", "string?", "Field label rendered above the select and associated via for/id."),
        new("Id", "string?", "Explicit select id used for label association; auto-generated when omitted."),
        new("Disabled", "bool", "Disables the whole control."),
    ];

    private sealed record ParamRow(string Name, string Type, string Description);
}
